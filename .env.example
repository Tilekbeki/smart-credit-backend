# Optional settings reference: Compose starts without a .env file.
# These defaults are for an isolated local demonstration only.
# Production requires explicit JWT_SECRET and private PostgreSQL credentials.
APP_ENV=demo
# Use a URL-safe password because the Compose DSN is a PostgreSQL URI.
POSTGRES_DB=smart_credit
POSTGRES_USER=smart_credit
POSTGRES_PASSWORD=smart-credit-demo-local-only
POSTGRES_PORT=5432

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Keep below Compose stop_grace_period (20s).
HTTP_SHUTDOWN_TIMEOUT=15s

# Local `go run ./cmd/api`; Compose uses the same credentials with host postgres.
DATABASE_URL=postgres://smart_credit:smart-credit-demo-local-only@localhost:5432/smart_credit?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=2s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

LOG_LEVEL=info
# Compose always mounts the document volume at /var/lib/smart-credit/documents.
DOCUMENT_STORAGE_PATH=./data/documents

# HTTP integration is enabled; the real Python service is supplied separately.
# Base Compose does not start scoring; use compose.scoring.yaml for local integration.
SCORING_URL=http://scoring:8001
# Optional integration only: directory containing the separate Dockerfile and scoring/.
# SCORING_CONTEXT=/absolute/path/to/smart-credit-scoring
# SCORING_MODEL=logreg_v1
# SCORING_PORT=8001
# Positive duration up to 1m; the worker lease is sized to outlive the HTTP call.
SCORING_TIMEOUT=5s
# Optional in demo: an empty value generates a random secret persisted in a volume.
# Explicit values take precedence and must contain at least 32 bytes.
# Required in production; never commit a real secret.
JWT_SECRET=
# Local Go default; Compose fixes this path inside its persistent secrets volume.
# JWT_SECRET_FILE=./data/secrets/jwt-secret
JWT_ISSUER=smart-credit-backend
JWT_AUDIENCE=smart-credit-frontend
AUTH_DB_TIMEOUT=3s
DEMO_OTP_CODE=1234
