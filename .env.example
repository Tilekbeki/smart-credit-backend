# Copy to .env and replace the placeholders before starting Compose.
# Use a URL-safe password because the Compose DSN is a PostgreSQL URI.
POSTGRES_DB=smart_credit
POSTGRES_USER=smart_credit
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Keep below Compose stop_grace_period (20s).
HTTP_SHUTDOWN_TIMEOUT=15s

# Local `go run ./cmd/api`; Compose uses the same credentials with host postgres.
DATABASE_URL=postgres://smart_credit:replace-with-local-password@localhost:5432/smart_credit?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=2s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

LOG_LEVEL=info
# Compose always mounts the document volume at /var/lib/smart-credit/documents.
DOCUMENT_STORAGE_PATH=./data/documents

# Reserved for future integration; no scoring service starts at this stage.
SCORING_URL=http://scoring:8001
JWT_SECRET=replace-with-a-random-secret-before-auth-is-enabled
DEMO_OTP_CODE=1234
