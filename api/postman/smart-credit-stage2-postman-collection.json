  "item": [
    {
      "name": "01 · Profiles — reset run, discover 3 clients and 1 employee",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/demo/profiles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "demo",
            "profiles"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Run on every Collection Runner iteration, preserving baseUrl and demoOtpCode.",
              "const resetKeys = [\"clientProfileId\", \"bankProfileId\", \"otpRequestId\", \"accessToken\", \"clientOtpRequestId\", \"bankOtpRequestId\", \"clientAccessToken\", \"bankAccessToken\", \"clientCompanyId\", \"clientName\", \"clientPhone\", \"bankName\", \"bankPhone\", \"previousClientOtpRequestId\"];",
              "resetKeys.forEach(key => { pm.collectionVariables.set(key, \"\"); pm.variables.set(key, \"\"); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
              "pm.test(\"Four valid demonstration profiles\", () => {",
              "  pm.expect(r).to.have.all.keys(\"items\");",
              "  pm.expect(r.items).to.be.an(\"array\").with.length(4);",
              "  const ids = new Set();",
              "  r.items.forEach(p => {",
              "    pm.expect(p).to.have.all.keys(\"id\", \"name\", \"role\", \"companyName\", \"phone\");",
              "    pm.expect(p.id).to.match(uuid); ids.add(p.id);",
              "    pm.expect(p.name).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(p.phone).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(p.role).to.be.oneOf([\"CLIENT\", \"BANK_EMPLOYEE\"]);",
              "    if (p.role === \"CLIENT\") pm.expect(p.companyName).to.be.a(\"string\").and.not.empty;",
              "    else pm.expect(p.companyName).to.eql(null);",
              "  });",
              "  pm.expect(ids.size).to.eql(4);",
              "});",
              "const profiles = Array.isArray(r.items) ? r.items : [];",
              "const clients = profiles.filter(p => p.role === \"CLIENT\");",
              "const employees = profiles.filter(p => p.role === \"BANK_EMPLOYEE\");",
              "pm.test(\"Three clients and one bank employee\", () => { pm.expect(clients).to.have.length(3); pm.expect(employees).to.have.length(1); });",
              "if (pm.response.code === 200) {",
              "  [[\"client\", clients[0]], [\"bank\", employees[0]]].forEach(([scope, p]) => {",
              "    if (!p) return;",
              "    pm.collectionVariables.set(scope + \"ProfileId\", p.id);",
              "    pm.collectionVariables.set(scope + \"Name\", p.name);",
              "    pm.collectionVariables.set(scope + \"Phone\", p.phone);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
