    {
      "name": "09 · Tampered JWT signature — /me returns unauthorized",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{invalidAccessToken}}"
