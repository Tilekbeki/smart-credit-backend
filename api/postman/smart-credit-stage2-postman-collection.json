            "otp",
            "request"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"profileId\": \"{{clientProfileId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
              "pm.test(\"OTP challenge DTO and five-minute expiry\", () => {",
              "  pm.expect(r).to.have.all.keys(\"otpRequestId\", \"expiresAt\", \"maskedPhone\");",
              "  pm.expect(r.otpRequestId).to.match(uuid);",
              "  pm.expect(r.expiresAt).to.be.a(\"string\");",
              "  const expires = Date.parse(r.expiresAt);",
              "  pm.expect(Number.isFinite(expires)).to.eql(true);",
              "  pm.expect(expires - Date.now()).to.be.within(1, 301000);",
              "  pm.expect(r.maskedPhone).to.be.a(\"string\").and.include(\"*\");",
              "  const phone = pm.collectionVariables.get(\"clientPhone\");",
              "  pm.expect(r.maskedPhone).to.eql(phone.slice(0, 2) + \"*** *** \" + phone.slice(-4));",
              "  pm.expect(r).not.to.have.property(\"code\");",
              "});",
              "if (pm.response.code === 201 && uuid.test(r.otpRequestId)) { pm.collectionVariables.set(\"clientOtpRequestId\", r.otpRequestId); pm.collectionVariables.set(\"otpRequestId\", r.otpRequestId); }"
            ]
          }
        }
      ]
    },
