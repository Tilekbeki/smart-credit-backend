        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Change the signature of a real issued JWT without knowing its secret.",
              "const parts = String(pm.collectionVariables.get(\"clientAccessToken\") || \"\").split(\".\");",
              "if (parts.length === 3 && parts[2].length > 0) {",
              "  parts[2] = (parts[2][0] === \"A\" ? \"B\" : \"A\") + parts[2].slice(1);",
              "  pm.variables.set(\"invalidAccessToken\", parts.join(\".\"));",
              "} else pm.variables.set(\"invalidAccessToken\", \"invalid.jwt.token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const r = pm.response.json();",
              "pm.test(\"Expected error and message, no credentials\", () => {",
              "  pm.expect(r).to.have.all.keys(\"error\", \"message\");",
              "  pm.expect(r.error).to.eql(\"unauthorized\");",
              "  pm.expect(r.message).to.eql(\"Требуется авторизация\");",
              "  pm.expect(r).not.to.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ]
    },
