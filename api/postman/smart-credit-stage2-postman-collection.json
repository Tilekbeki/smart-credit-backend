    {
      "name": "05 · Client — correct OTP returns JWT",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "otp",
            "verify"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"otpRequestId\": \"{{clientOtpRequestId}}\",\n  \"code\": \"{{demoOtpCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
              "pm.test(\"Access token DTO and database identity\", () => {",
              "  pm.expect(r).to.have.all.keys(\"accessToken\", \"tokenType\", \"expiresAt\", \"userId\", \"role\", \"companyId\");",
              "  pm.expect(r.accessToken).to.be.a(\"string\").and.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/);",
              "  pm.expect(r.tokenType).to.eql(\"Bearer\");",
              "  pm.expect(r.userId).to.match(uuid);",
              "  pm.expect(r.userId).to.eql(pm.collectionVariables.get(\"clientProfileId\"));",
              "  pm.expect(r.role).to.eql(\"CLIENT\");",
              "  pm.expect(r.expiresAt).to.be.a(\"string\");",
              "  pm.expect(r.companyId).to.match(uuid);",
              "});",
              "// Decode public JWT claims only. Signing keys are never known to the collection.",
              "function decodeJWTPart(value) {",
              "  const alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";",
              "  let bits = 0, count = 0, text = \"\";",
              "  for (const char of value.replace(/-/g, \"+\").replace(/_/g, \"/\")) {",
              "    const digit = alphabet.indexOf(char); if (digit < 0) continue;",
              "    bits = (bits << 6) | digit; count += 6;",
              "    if (count >= 8) { count -= 8; text += String.fromCharCode((bits >> count) & 255); }",
              "  }",
              "  return JSON.parse(text);",
              "}",
              "pm.test(\"HS256 JWT identity and eight-hour lifetime\", () => {",
              "  const parts = r.accessToken.split(\".\");",
              "  const header = decodeJWTPart(parts[0]); const claims = decodeJWTPart(parts[1]);",
              "  pm.expect(header.alg).to.eql(\"HS256\"); pm.expect(header.typ).to.eql(\"JWT\");",
              "  pm.expect(claims.sub).to.eql(r.userId);",
              "  pm.expect(claims.iss).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(Array.isArray(claims.aud) ? claims.aud.length > 0 && claims.aud.every(a => typeof a === \"string\" && a.length > 0) : typeof claims.aud === \"string\" && claims.aud.length > 0).to.eql(true);",
              "  pm.expect(claims.iat).to.be.a(\"number\"); pm.expect(claims.exp).to.be.a(\"number\");",
              "  pm.expect(claims.exp - claims.iat).to.eql(8 * 60 * 60);",
              "  pm.expect(Math.abs(claims.iat * 1000 - Date.now())).to.be.below(30000);",
              "  pm.expect(Date.parse(r.expiresAt)).to.eql(claims.exp * 1000);",
              "  pm.expect(claims.exp * 1000).to.be.above(Date.now());",
              "});",
              "if (pm.response.code === 200 && typeof r.accessToken === \"string\") { pm.collectionVariables.set(\"clientAccessToken\", r.accessToken); pm.collectionVariables.set(\"accessToken\", r.accessToken); }",
              "if (pm.response.code === 200 && uuid.test(r.companyId)) pm.collectionVariables.set(\"clientCompanyId\", r.companyId);"
            ]
          }
        }
      ]
    },
